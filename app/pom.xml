<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- app's parent is root directly, not core: root lists core and app as siblings
         and is the parent of both. -->
    <parent>
        <groupId>patmal.workshops.student.impl</groupId>
        <artifactId>root</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>app</artifactId>
    <packaging>jar</packaging>

    <dependencies>
        <dependency>
            <groupId>patmal.workshops.student.impl</groupId>
            <artifactId>logic-impl</artifactId>
        </dependency>
        <!-- the actual logging engine: only needed to run, not to compile -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
        </dependency>
        <!-- runs our build against the tester in the verify phase (bonus 8.2);
             test scope keeps it out of the uber jar -->
        <dependency>
            <groupId>patmal.workshops</groupId>
            <artifactId>workshop-tester</artifactId>
        </dependency>
    </dependencies>

    <build>
        <!-- names the plain jar (and, after shading below, the uber jar too) workshop-cli.jar -->
        <finalName>workshop-cli</finalName>
        <plugins>
            <!-- bundles app + logic-impl + model-impl + every runtime dependency into one
                 jar, and writes Main-Class into the manifest so "java -jar" knows what to
                 run. Bound to the package phase, so a normal "mvn install" produces it. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>patmal.workshops.student.impl.main.Main</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- bonus 8.2: runs the tester in the verify phase, in a real "java -cp"
                 subprocess (exec:exec, not exec:java) - the tester finds our
                 WorkshopSystemImpl by scanning java.class.path at runtime, exactly as
                 section 7's manual command does, which only a genuine JVM process
                 exposes correctly. A non-zero exit code from that process fails this
                 build. The classpath (compile+runtime deps plus the test-scoped tester
                 jar) is generated by the empty <classpath/> argument below. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>run-workshop-tester</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>java</executable>
                            <classpathScope>test</classpathScope>
                            <arguments>
                                <argument>-cp</argument>
                                <classpath/>
                                <argument>patmal.workshops.main.Main</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
